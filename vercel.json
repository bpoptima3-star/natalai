{
  "rewrites": [
    {
      "source": "/((?!api|privacy-policy|blog).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chart.js": {
      "maxDuration": 30
    },
    "api/send-report.js": {
      "maxDuration": 20
    },
    "api/paypal-webhook.js": {
      "maxDuration": 60
    }
  }
}
